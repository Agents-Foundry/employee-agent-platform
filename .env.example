PORT=4100
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,tauri://localhost

# PostgreSQL (docs/adr/0018-postgresql-row-level-security.md). Three login roles on one
# database: the schema owner (migrations), the tenant role (row-level security enforced; must
# not have BYPASSRLS) and the platform role (sign-in, sessions, runtime claims). Local setup:
#   npm run db:dev && npm run db:bootstrap
# These are development-only passwords for the local container.
DATABASE_URL=postgres://agents_foundry_app:app-dev-password@127.0.0.1:55433/agents_foundry
DATABASE_PLATFORM_URL=postgres://agents_foundry_platform:platform-dev-password@127.0.0.1:55433/agents_foundry
# When set, the API applies pending migrations at startup; otherwise run npm run db:migrate.
DATABASE_MIGRATION_URL=postgres://agents_foundry_owner:owner-dev-password@127.0.0.1:55433/agents_foundry
# Superuser URL, used only by npm run db:bootstrap.
DATABASE_ADMIN_URL=postgres://postgres:agents-foundry-dev@127.0.0.1:55433/postgres
# Ed25519 key that signs manifests and execution grants. Keep it with the database backups.
# MANIFEST_SIGNING_KEY_PATH=.data/agents-foundry.db.signing-key.pem

# Default server mode is Google; missing values fail startup.
# For the isolated local demo instead: npm run dev:api:demo
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=example.com
GOOGLE_CALLBACK_URL=http://localhost:4100/api/auth/callback
ADMIN_APP_URL=http://localhost:4200/
EMPLOYEE_APP_URL=http://localhost:4300/
# Relative to apps/control-plane-api when launched with npm scripts.
IDENTITY_DIRECTORY_PATH=../../.data/google-memberships.json

# Architecture V2 (docs/migration-plan.md). Issue agents-foundry/v2 manifests to new agents.
# Existing v1 manifests are unaffected. Default: false.
AGENT_MANIFEST_V2_ISSUANCE_ENABLED=false

# Phase C (docs/agent-runtime.md). Employees may start generic runs; runtimes authenticate with
# registered Ed25519 public keys. Unset identities mean no runtime can connect.
GENERIC_AGENT_RUNTIME_ENABLED=false
# AGENT_RUNTIME_IDENTITIES_PATH=../../.data/runtime-identities.json

# Phase D (docs/action-gateway.md). Connector secrets per organization:
# {"<organizationId>": {"jira-api-token": "<token>"}}. Unset: governed writes fail closed.
# CONNECTOR_SECRETS_PATH=../../.data/connector-secrets.json

# Agent runtime process (npm run dev:runtime)
# CONTROL_PLANE_URL=http://127.0.0.1:4100
# AGENT_RUNTIME_ID=local-runtime
# AGENT_RUNTIME_PRIVATE_KEY_PATH=../../.data/runtime-key.pem
# MANIFEST_VERIFICATION_KEY=
# AF_MODEL_API_KEY_ANTHROPIC=
# AGENT_RUNTIME_ENABLE_SCRIPTED_MODEL=false

# Phase E (docs/execution-runtime.md). Execution runtime process (npm run dev:execution).
# EXECUTION_GRANT_VERIFICATION_KEY=      # base64 SPKI from GET /api/manifest-key
# EXECUTION_RUNTIME_PORT=4500
# EXECUTION_ALLOW_UNSANDBOXED=false      # development only: local provider is not a sandbox
# Phase G (docs/adr/0015-frontend-engineer-and-sandboxed-execution.md). Container sandbox:
# EXECUTION_PROVIDER=container
# EXECUTION_SANDBOX_IMAGE=node:22-bookworm-slim
# EXECUTION_PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.55.0-noble   # or build apps/execution-runtime/sandbox/playwright.Dockerfile
# EXECUTION_EGRESS_PROXY=true    # docs/adr/0016-egress-proxy.md: enforce grant host allow-lists
# EXECUTION_EGRESS_PROXY_IMAGE=node:22-bookworm-slim
# EXECUTION_ALLOW_UNRESTRICTED_EGRESS=false   # only without the proxy; development only
# Agent runtime: offer the workspace tools through this execution runtime.
# EXECUTION_RUNTIME_URL=http://127.0.0.1:4500

# Phase F (docs/adr/0014-qa-on-the-generic-runtime.md). /api/qa/runs queues validate-story runs
# for agents with a v2 manifest; others keep the legacy static plan. Default: false.
QA_GENERIC_RUNTIME_ENABLED=false
