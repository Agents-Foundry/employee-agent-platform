PORT=4100
DATABASE_PATH=.data/agents-foundry.db
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,tauri://localhost

# Default server mode is Google; missing values fail startup.
# For the isolated local demo instead: npm run dev:api:demo
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=example.com
GOOGLE_CALLBACK_URL=http://localhost:4100/api/auth/callback
ADMIN_APP_URL=http://localhost:4200/
EMPLOYEE_APP_URL=http://localhost:4300/
# Relative to apps/control-plane-api when launched with npm scripts.
IDENTITY_DIRECTORY_PATH=../../.data/google-memberships.json
