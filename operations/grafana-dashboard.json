{
  "title": "Agents Foundry pilot",
  "uid": "agents-foundry-pilot",
  "description": "Generated by `npm run ops:render` from packages/operations (ADR 0039).",
  "tags": [
    "agents-foundry"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running, queued and waiting runs",
      "description": "Runs right now, by status. Waiting means waiting for an approval.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (af_runs)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Failed runs",
      "description": "Runs that failed in the last hour, by reason code.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(af_runs_finished_total{status=\"FAILED\"}[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Completion rate",
      "description": "Share of runs that ended in the last six hours and completed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (increase(af_runs_finished_total{status=\"COMPLETED\"}[6h]))) / (sum (increase(af_runs_finished_total[6h])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue wait (p95)",
      "description": "How long runs waited for a runtime.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(af_run_queue_wait_ms_bucket[1h])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Recovery",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Expired leases",
      "description": "Runs whose runtime stopped signalling and that nothing has picked up yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (af_runtime_leases{state=\"expired\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Recovery rate",
      "description": "Runs handed to another runtime, per lease found expired, in six hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (increase(af_run_recoveries_total[6h]))) / (sum (increase(af_runtime_leases_expired_total[6h])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Abandoned runs",
      "description": "Runs cancelled because nothing could continue them, by code.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (increase(af_runs_abandoned_total[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Checkpoint conflicts and corruption",
      "description": "Saves refused (two runtimes on one run, a stale version) and loads that failed verification.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(af_checkpoint_writes_total{result!=\"saved\"}[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Checkpoint loads refused",
      "description": "Loads that were neither a verified checkpoint nor an absent one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(af_checkpoint_reads_total{result!~\"loaded|missing\"}[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Governance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Writes to reconcile",
