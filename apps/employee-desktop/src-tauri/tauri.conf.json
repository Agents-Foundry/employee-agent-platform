{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Foundry Employee",
  "version": "0.1.0",
  "identifier": "com.agentsfoundry.employee",
  "build": {
    "beforeDevCommand": "npm --prefix ../../.. run start:employee",
    "devUrl": "http://localhost:4300",
    "beforeBuildCommand": "npm --prefix ../../.. run build:employee",
    "frontendDist": "../../../dist/employee-desktop/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Agents Foundry · QA Employee",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' http://127.0.0.1:4100 http://localhost:4100; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
